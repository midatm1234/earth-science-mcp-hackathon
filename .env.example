# Copy to .env only if you need to change a default. Nothing here is required
# for the core workshop: the starter server and Earthdata metadata search need
# no credentials. Never commit .env.

# obs-model-starter HTTP transport (defaults shown)
OBS_MODEL_HOST=127.0.0.1
OBS_MODEL_PORT=8765
OBS_MODEL_LOG_LEVEL=INFO

# Public NASA Earthdata MCP endpoint used for dataset discovery
EARTHDATA_MCP_URL=https://cmr.earthdata.nasa.gov/mcp/v1

# Future organizer-managed shared server (TBD). Leave empty until announced.
HACKATHON_SHARED_MCP_URL=

# Only for optional data DOWNLOADS with earthaccess (not used by any test or tool here).
# Prefer `earthaccess.login()` interactive prompt or ~/.netrc instead of this file.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
